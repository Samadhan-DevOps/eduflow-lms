# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (individual vars — used when DATABASE_URL is not set) ───────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eduflow
DB_USER=eduflow_user
DB_PASSWORD=eduflow_secure_password_123

# ─── Database URL (overrides individual DB_ vars when set) ───────────────────
DATABASE_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRES_IN=7d

# ─── CORS (comma-separated, no spaces) ────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
